# Скопіюйте цей файл у .env та заповніть реальними значеннями.
# Ніколи не додавайте .env у git!

# Токен бота від @BotFather
BOT_TOKEN=123456789:AAExampleTokenHere

# ID адмін-групи/каналу, куди прилітають нові замовлення (зазвичай починається з -100)
ADMIN_CHAT_ID=-1001234567890

# ID користувачів-адмінів, які мають доступ до /admin (через кому)
ADMIN_USER_IDS=111111111,222222222

# Google Sheets (не обов'язково — якщо не заповнити, запис у таблицю просто пропускається)
GOOGLE_SHEETS_JSON=credentials.json
SPREADSHEET_NAME=Aqua Frank Orders

# Шлях до файлу бази даних SQLite
DB_PATH=aquafrank.db
